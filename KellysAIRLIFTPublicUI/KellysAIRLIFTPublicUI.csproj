<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>KellysAIRLIFTPublicUI</AssemblyName>
    <RootNamespace>KellysAirliftPublicUI</RootNamespace>
    <Version>0.17.1</Version>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <BepInExPath Condition="'$(BEPINEX_DIR)' != ''">$(BEPINEX_DIR)</BepInExPath>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(NUCLEAR_OPTION_DIR)\BepInEx\core</BepInExPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExPath)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExPath)\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Mirage" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\Mirage.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
</Project>

